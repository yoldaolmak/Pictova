# Pictova Configuration
#
# Değerler tırnak içine alınabilir; tırnaklar okunurken soyulur.
# Aynı anahtar birden çok kez tanımlanırsa son satır geçerlidir.
# Gerçek bir ortam değişkeni her zaman bu dosyayı ezer.

# ── Vision Chain (analyze_image_vision_chain sırası) ─────────────────────────
# 1. LM Studio — lokal, ücretsiz. http://localhost:1234 üzerinde bir VL modeli
#    (ör. qwen2.5-vl-7b-instruct) yüklüyse ilk sırada denenir, ayar gerekmez.
#
# 2. Gemini Flash — Google AI Studio, ücretsiz (kart gerekmez)
#    https://aistudio.google.com/apikey
#    Tek anahtar için GEMINI_API_KEY, kota bölüştürmek için virgülle ayrılmış
#    GEMINI_API_KEYS kullanılır. İkisi de varsa çoğul olan tercih edilir.
GEMINI_API_KEY=
GEMINI_API_KEYS=
# Varsayılan: gemini-2.5-flash
GEMINI_VISION_MODEL=
# `scripts/fast_scan.py` için günlük tamamlanmış tarama üst sınırı.
# 0 yalnızca gözlenen, sınırsız bir çalıştırma için kullanılmalı.
PICTOVA_VISION_DAILY_LIMIT=1350

# 3. OpenAI mini vision — ucuz, sınırlı yedek
OPENAI_API_KEY=

# 4. Codex CLI web login — terminalde: codex login
#    ~/.codex/auth.json oturumu yeterli, buraya bir şey yazma
#
# 5. Claude CLI web login — bu oturum zaten açık
#    claude --version ile kontrol et

# ── WordPress siteleri ───────────────────────────────────────────────────────
# Her site için url + user + app password gerekir; eksikse `pictova health`
# o siteyi "blocked" olarak raporlar.
WP_URL=https://yoldaolmak.com
WP_USER=hamal
WP_APP_PASSWORD=

GEZIEVRENI_URL=https://gezievreni.com
GEZIEVRENI_USER=hamal
GEZIEVRENI_PASS=

GEZGINDUNYASI_URL=https://gezgindunyasi.com
GEZGINDUNYASI_USER=clawdbot
GEZGINDUNYASI_PASS=

# ── DepositPhotos (lisanslı stok görsel) ─────────────────────────────────────
DEPOSIT_API_KEY=
DEPOSIT_LOGIN_USER=yoldaolmak
DEPOSIT_LOGIN_PASSWORD=

# ── Unsplash ─────────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=

# ── Visual Memory DB ve dizinler ─────────────────────────────────────────────
YO_VISUAL_MEMORY_DB=/Users/yoldaolmak/Projects/Pictova/data/visual_memory.db
# Opsiyonel — varsayılanları proje içindedir
YO_VIL_DIR=
PICTOVA_POST_MANIFEST_DIR=
PICTOVA_OPERATION_RECEIPT_DIR=
