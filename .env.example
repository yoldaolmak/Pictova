# Pictova — copy to .env. Do not commit credentials.
#
# Configure only the sites and providers you use.
# A missing site password is reported as blocked by `pictova health`.

# WordPress (yoldaolmak profile; other profiles are optional)
WP_URL=https://yoldaolmak.com
WP_USER=
WP_APP_PASSWORD=

GEZIEVRENI_URL=https://gezievreni.com
GEZIEVRENI_USER=
GEZIEVRENI_PASS=

GEZGINDUNYASI_URL=https://gezgindunyasi.com
GEZGINDUNYASI_USER=
GEZGINDUNYASI_PASS=

# Optional local image index (defaults to data/visual_memory.db)
YO_VISUAL_MEMORY_DB=

# Optional image sources
UNSPLASH_ACCESS_KEY=
DEPOSIT_API_KEY=
DEPOSIT_LOGIN_USER=
DEPOSIT_LOGIN_PASSWORD=

# Optional visual analysis: local LM Studio needs no API key
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_VISION_MODEL=
OPENAI_API_KEY=

# Explicit vision scan budget
PICTOVA_VISION_DAILY_LIMIT=1350

# Optional output locations
YO_VIL_DIR=
PICTOVA_POST_MANIFEST_DIR=
PICTOVA_OPERATION_RECEIPT_DIR=

# Required for `pictova serve`; `pictova studio` can generate a local token
PICTOVA_HTTP_TOKEN=
